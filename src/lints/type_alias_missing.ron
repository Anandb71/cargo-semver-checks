// NOTE: This lint is currently blocked by lack of TypeAlias support in trustfall-rustdoc-adapter.
// TypeAlias exists in rustdoc-types (https://docs.rs/rustdoc-types/latest/rustdoc_types/enum.ItemEnum.html)
// but is not yet exposed in the trustfall-rustdoc-adapter GraphQL schema.
// Once TypeAlias support is added to the adapter, this lint should work as-is.
// Related issues: #1254, #473, #609
SemverQuery(
    id: "type_alias_missing",
    human_readable_name: "pub type alias removed or renamed",
    description: "A type alias can no longer be imported by its prior path.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/cargo/reference/semver.html#item-remove"),
    query: r#"
    {
        CrateDiff {
            baseline {
                item {
                    ... on TypeAlias {
                        visibility_limit @filter(op: "=", value: ["$public"]) @output
                        name @output

                        importable_path {
                            path @output @tag
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        span_: span @optional {
                            filename @output
                            begin_line @output
                            end_line @output
                        }
                    }
                }
            }
            current @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                item {
                    ... on TypeAlias {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "zero": 0,
        "true": true,
    },
    error_message: "A publicly-visible type alias cannot be imported by its prior path. A `pub use` may have been removed, or the type alias itself may have been renamed or removed entirely.",
    per_result_error_template: Some("type alias {{join \"::\" path}}, previously in file {{span_filename}}:{{span_begin_line}}"),
)
